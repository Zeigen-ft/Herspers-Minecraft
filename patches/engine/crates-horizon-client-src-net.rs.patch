+    #[test]
+    fn bounded_network_queue_preserves_order_when_receiver_pauses() {
+        use std::sync::mpsc::TrySendError;
+        let (send, events) = sync_channel(NET_EVENT_CAPACITY);
+        for i in 0..NET_EVENT_CAPACITY {
+            send.try_send(Event::Status(i.to_string())).unwrap();
+        }
+        assert!(matches!(
+            send.try_send(Event::Status("next".into())),
+            Err(TrySendError::Full(_))
+        ));
+        let (ready, opened) = channel();
+        let producer = std::thread::spawn(move || {
+            ready.send(()).unwrap();
+            send.send(Event::Status("next".into())).unwrap();
+        });
+        opened.recv_timeout(Duration::from_secs(5)).unwrap();
+        for i in 0..NET_EVENT_CAPACITY {
+            assert!(
+                matches!(events.recv_timeout(Duration::from_secs(5)), Ok(Event::Status(s)) if s == i.to_string())
+            );
+        }
+        assert!(
+            matches!(events.recv_timeout(Duration::from_secs(5)), Ok(Event::Status(s)) if s == "next")
+        );
+        producer.join().unwrap();
+    }
