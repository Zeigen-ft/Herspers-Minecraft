+        use play::Clientbound as C;
+        use std::time::Instant;
+
+        let host = Lan::start_with(
+            Arc::new(SyncData::empty()),
+            NetConfig {
+                bind: Some(std::net::Ipv4Addr::LOCALHOST.into()),
+                announce: false,
+                ..NetConfig::lan(0, "Test".into(), 8)
+            },
+        )
+        .unwrap();
+        let connect = |name: &str| {
+            let session = Session::connect(
+                &format!("127.0.0.1:{}", host.port),
+                name,
+                None,
+                cfg::ClientInformation::new(8),
+                Arc::new(Language::new()),
+                PathBuf::new(),
+            );
+            let deadline = Instant::now() + Duration::from_secs(10);
+            loop {
+                let event = session
+                    .events
+                    .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                    .unwrap();
+                match event {
+                    Event::Joined {
+                        uuid,
+                        name: accepted,
+                        ..
+                    } => {
+                        assert_eq!(accepted, name);
+                        assert_eq!(uuid, offline_uuid(name));
+                        break;
+                    }
+                    Event::Disconnected { reason, .. } => panic!("login failed: {reason}"),
+                    _ => {}
+                }
+            }
+            loop {
+                if let Some(player) = host.poll().into_iter().find_map(|e| match e {
+                    NetEvent::Joined(player) => Some(player),
+                    _ => None,
+                }) {
+                    assert_eq!(player.name, name);
+                    assert_eq!(player.uuid, offline_uuid(name));
+                    return (session, player.sender);
+                }
+                assert!(Instant::now() < deadline);
+                std::thread::sleep(Duration::from_millis(1));
+            }
+        };
+        let section = Section {
+            non_empty: 0,
+            fluids: 0,
+            states: Paletted::from_values(&[0; 4096], Strategy::Blocks, 16),
+            biomes: Paletted::from_values(&[0; 64], Strategy::Biomes, 2),
+        };
+        let column = C::LevelChunkWithLight(play::LevelChunkWithLight {
+            x: 7,
+            z: -2,
+            chunk: ChunkData {
+                heightmaps: vec![],
+                buffer: ChunkData::from_sections(&vec![section; 24]),
+                block_entities: vec![],
+            },
+            light: LightData {
+                sky_mask: vec![],
+                block_mask: vec![],
+                empty_sky_mask: vec![],
+                empty_block_mask: vec![],
+                sky: vec![],
+                block: vec![],
+            },
+        })
+        .encode();
+        let forget = C::ForgetLevelChunk(play::ForgetLevelChunk { pos: [7, -2] }).encode();
+        let mut clients = Vec::new();
+        for name in ["CJ_Corto", "Second_2", "Third_3"] {
+            clients.push(connect(name));
+            for (_, player) in &clients {
+                player.send_many([
+                    column.clone(),
+                    forget.clone(),
+                    column.clone(),
+                    forget.clone(),
+                ]);
+            }
+            for (session, _) in &clients {
+                let deadline = Instant::now() + Duration::from_secs(10);
+                let mut count = 0;
+                while count < 4 {
+                    let ev = session
+                        .events
+                        .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                        .unwrap();
+                    match ev {
+                        Event::Packet(p) => match *p {
+                            C::LevelChunkWithLight(ref c) => {
+                                assert_eq!((count % 2, c.x, c.z), (0, 7, -2));
+                                assert_eq!(c.chunk.sections(24, 16, 2).unwrap().len(), 24);
+                                count += 1;
+                            }
+                            C::ForgetLevelChunk(c) => {
+                                assert_eq!((count % 2, c.pos), (1, [7, -2]));
+                                count += 1;
+                            }
+                            _ => {}
+                        },
+                        Event::Disconnected { reason, .. } => panic!("early disconnect: {reason}"),
+                        _ => {}
+                    }
+                }
+            }
+        }
+        let (third, sender) = clients.pop().unwrap();
+        sender.disconnect(horizon_world::nbt::Tag::String("Test host restart".into()));
+        let deadline = Instant::now() + Duration::from_secs(10);
+        loop {
+            let ev = third
+                .events
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                .unwrap();
+            if let Event::Disconnected {
+                reason,
+                from_server,
+            } = ev
+            {
+                assert!(from_server);
+                assert_eq!(reason, "Test host restart");
+                break;
+            }
+        }
+        drop(third);
+        clients.push(connect("Third_3"));
+    }
 
