+    #[test]
+    fn truncated_column_fails_and_a_new_decoder_starts_empty() {
+        let format = Arc::new(ChunkFormat::new(
+            &DimensionType::vanilla("minecraft:overworld"),
+            vec![0, 1],
+            2,
+        ));
+        let mut p = packet(1, 2);
+        let C::LevelChunkWithLight(c) = p.as_mut() else {
+            unreachable!()
+        };
+        assert!(format.column(c).is_ok());
+        let changed =
+            Arc::new(format.with_dimension(&DimensionType::vanilla("minecraft:the_nether")));
+        assert!(
+            changed
+                .resolve(c, Some((&format, Err("obsolete result".into()))))
+                .is_ok()
+        );
+        assert!(
+            format
+                .resolve(c, Some((&format, Err("current error".into()))))
+                .is_err()
+        );
+        c.chunk.buffer.pop();
+        assert!(format.column(c).is_err());
+        c.chunk.buffer.clear();
+        assert!(format.column(c).is_err());
+        let old = ChunkDecoder::new();
+        assert!(old.submit(format.clone(), packet(1, 2)).is_none());
+        drop(old);
+        let fresh = ChunkDecoder::new();
+        assert!(matches!(fresh.next(), Next::Decoding));
+        assert!(fresh.submit(format, packet(9, 2)).is_none());
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        loop {
+            match fresh.next() {
+                Next::Ready((p, Ok(_))) if matches!(*p, C::LevelChunkWithLight(ref c) if c.x == 9) => {
+                    break;
+                }
+                Next::Decoding => std::thread::yield_now(),
+                _ => panic!("unexpected result from new session"),
+            }
+            assert!(std::time::Instant::now() < deadline);
+        }
     }
 
