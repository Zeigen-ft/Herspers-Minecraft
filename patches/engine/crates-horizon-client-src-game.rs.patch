+    fn private_name_cli_uses_exact_name_with_or_without_direct_join() {
+        for mut args in [vec![], vec!["--server", "localhost:25565"]] {
+            args.extend(["--name", "CJ_Corto"]);
+            let options = Options::parse(args.into_iter().map(String::from))
+                .unwrap()
+                .unwrap();
+            assert_eq!(options.player_name(), "CJ_Corto");
+        }
+        let solo = Options::parse(["--name", "SoloOwner"].into_iter().map(String::from))
+            .unwrap()
+            .unwrap();
+        assert_eq!(solo.multiplayer_name(Some("CJ_Corto")), "CJ_Corto");
+        assert_eq!(solo.multiplayer_name(Some("bad name")), "SoloOwner");
+        assert_eq!(solo.player_name(), "SoloOwner");
+        for bad in ["a", "also bad", "é123", "abcdefghijklmnopq"] {
+            assert!(Options::parse(["--name", bad].into_iter().map(String::from)).is_err());
+        }
+    }
